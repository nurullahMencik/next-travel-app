# ---------------------------------------------------------------------------
# Bu dosyayi ".env" olarak kopyalayip degerleri doldurun.
# Vercel'de ayni degiskenler Project Settings > Environment Variables altinda
# tanimli olmalidir.
# ---------------------------------------------------------------------------

# MongoDB baglanti adresi (Prisma MongoDB connector'u replica set ister,
# MongoDB Atlas varsayilan olarak replica set kullanir).
DATABASE_URL="mongodb+srv://<kullanici>:<sifre>@<cluster>.mongodb.net/<veritabani>?retryWrites=true&w=majority"

# NextAuth oturum imzalama anahtari. Uretmek icin: openssl rand -base64 32
NEXTAUTH_SECRET=""

# Uygulamanin calistigi tam adres. Yerelde http://localhost:3000,
# Vercel'de https://<proje>.vercel.app olmalidir.
NEXTAUTH_URL="http://localhost:3000"

# Iletisim formu icin Resend API anahtari (opsiyonel; tanimli degilse
# iletisim formu 503 doner, uygulamanin geri kalani calismaya devam eder).
RESEND_API_KEY=""

# Google reCAPTCHA anahtarlari (opsiyonel; tanimli degilse dogrulama atlanir).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""
